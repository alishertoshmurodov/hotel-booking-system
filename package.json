{
  "name": "hotel-booking-system",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-bookings-management": "cds watch --open bookingsmanagement/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/bookings-management"
  ],
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "admin": { "password": "admin", "roles": ["Admin"] },
          "manager": { "password": "manager", "roles": ["Manager"] },
          "alice": { "password": "alice", "roles": ["Customer"] },
          "bob": { "password": "bob", "roles": ["Customer"] },
          "*": false
        }
      }
    }
  }
}
